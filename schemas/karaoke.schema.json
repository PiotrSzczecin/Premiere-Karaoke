{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/premiere-karaoke.schema.json",
  "title": "Premiere Karaoke project",
  "type": "object",
  "required": ["schemaVersion", "app", "source", "settings", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "app": { "const": "Premiere Karaoke UXP" },
    "savedAt": { "type": "string" },
    "source": { "type": "object" },
    "settings": { "type": "object" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "number", "start", "end", "text", "plainText", "words", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "number": { "type": "integer", "minimum": 0 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "exclusiveMinimum": 0 },
          "text": { "type": "string" },
          "plainText": { "type": "string" },
          "status": { "enum": ["unmatched", "quick", "aligned", "low-confidence", "error"] },
          "dirty": { "type": "boolean" },
          "selected": { "type": "boolean" },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "words": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["index", "text", "normalized", "start", "end", "confidence"],
              "properties": {
                "index": { "type": "integer", "minimum": 0 },
                "text": { "type": "string" },
                "normalized": { "type": "string" },
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "minimum": 0 },
                "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
