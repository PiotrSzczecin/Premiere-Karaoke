{
  "manifestVersion": 5,
  "id": "com.pilne24.premiere-karaoke",
  "name": "Karaoke Captions PL",
  "version": "0.4.8",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.3.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": "all"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "karaokeCaptionsPanel",
      "label": { "default": "Karaoke Captions PL" },
      "minimumSize": { "width": 360, "height": 520 },
      "preferredDockedSize": { "width": 430, "height": 760 },
      "preferredFloatingSize": { "width": 520, "height": 820 }
    }
  ]
}
